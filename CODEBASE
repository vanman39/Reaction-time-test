#include <GxEPD2_BW.h>
#include <Fonts/FreeSans9pt7b.h>
#include <Preferences.h>

// E-Paper Display Setup (Using your labeled pins: CS=5, DC=21, RST=22, BUSY=19)
GxEPD2_BW<GxEPD2_154_D67, GxEPD2_154_D67::HEIGHT> display(GxEPD2_154_D67(/*CS=*/ 5, /*DC=*/ 21, /*RST=*/ 22, /*BUSY=*/ 19));

Preferences preferences;

const int redPin = 26;
const int greenPin = 25;
const int buttonPin = 27;

unsigned long startTime = 0;
unsigned long reactionTime = 0;
unsigned long timerEvent = 0;
unsigned long highScore = 0; // Stored in microseconds

enum State { IDLE, WAITING_DELAY, READY_TO_REACT, SHOWING_RESULT };
State currentState = IDLE;

void setup() {
  Serial.begin(115200);
  
  pinMode(redPin, OUTPUT);
  pinMode(greenPin, OUTPUT);
  pinMode(buttonPin, INPUT_PULLUP);

  digitalWrite(redPin, LOW);
  digitalWrite(greenPin, LOW);

  // Initialize Preferences storage and load high score
  preferences.begin("reaction", false);
  highScore = preferences.getULong("highScore", 0);

  // Initialize display
  display.init(115200);
  display.setRotation(1);
  
  drawSplashScreen();
}

void loop() {
  switch (currentState) {
    case IDLE:
      digitalWrite(redPin, LOW);
      digitalWrite(greenPin, LOW);
      
      if (digitalRead(buttonPin) == LOW) {
        delay(50);
        if (digitalRead(buttonPin) == LOW) {
          currentState = WAITING_DELAY;
          digitalWrite(redPin, HIGH);
          digitalWrite(greenPin, LOW);
          drawWaitingScreen();
          timerEvent = millis() + random(2000, 5000);
        }
      }
      break;

    case WAITING_DELAY:
      if (digitalRead(buttonPin) == LOW) {
        delay(50);
        if (digitalRead(buttonPin) == LOW) {
          digitalWrite(redPin, LOW);
          currentState = IDLE;
          drawFalseStartScreen();
          delay(1000);
          drawSplashScreen();
        }
      }
      
      if (millis() >= timerEvent) {
        digitalWrite(redPin, LOW);
        digitalWrite(greenPin, HIGH);
        startTime = micros();
        currentState = READY_TO_REACT;
      }
      break;

    case READY_TO_REACT:
      if (digitalRead(buttonPin) == LOW) {
        delay(10);
        if (digitalRead(buttonPin) == LOW) {
          unsigned long endTime = micros();
          reactionTime = endTime - startTime;
          
          digitalWrite(greenPin, LOW);
          currentState = SHOWING_RESULT;

          // Check if it's a new high score (lower time is better) and save it permanently
          if (highScore == 0 || reactionTime < highScore) {
            highScore = reactionTime;
            preferences.putULong("highScore", highScore);
          }
          
          drawResultScreen(reactionTime, highScore);
          delay(3000);
          currentState = IDLE;
          drawSplashScreen();
        }
      }
      break;

    case SHOWING_RESULT:
      break;
  }
}

void drawSplashScreen() {
  display.setPartialWindow(0, 0, display.width(), display.height());
  display.firstPage();
  do {
    display.fillScreen(GxEPD_WHITE);
    display.setTextColor(GxEPD_BLACK);
    display.setFont(&FreeSans9pt7b);
    display.setCursor(10, 30);
    display.print("Reaction Tester");
    
    display.setCursor(10, 65);
    if (highScore > 0) {
      display.print("Best: ");
      display.print(highScore / 1000.0, 1);
      display.print(" ms");
    } else {
      display.print("Best: None yet");
    }
    
    display.setCursor(10, 100);
    display.print("Press to start!");
  } while (display.nextPage());
}

void drawWaitingScreen() {
  display.setPartialWindow(0, 0, display.width(), display.height());
  display.firstPage();
  do {
    display.fillScreen(GxEPD_WHITE);
    display.setTextColor(GxEPD_BLACK);
    display.setFont(&FreeSans9pt7b);
    display.setCursor(10, 60);
    display.print("Get ready...");
  } while (display.nextPage());
}

void drawFalseStartScreen() {
  display.setPartialWindow(0, 0, display.width(), display.height());
  display.firstPage();
  do {
    display.fillScreen(GxEPD_WHITE);
    display.setTextColor(GxEPD_BLACK);
    display.setFont(&FreeSans9pt7b);
    display.setCursor(10, 60);
    display.print("Too early!");
  } while (display.nextPage());
}

void drawResultScreen(unsigned long timeUs, unsigned long bestUs) {
  float timeMs = timeUs / 1000.0;
  float bestMs = bestUs / 1000.0;
  
  display.setPartialWindow(0, 0, display.width(), display.height());
  display.firstPage();
  do {
    display.fillScreen(GxEPD_WHITE);
    display.setTextColor(GxEPD_BLACK);
    display.setFont(&FreeSans9pt7b);
    
    display.setCursor(10, 35);
    display.print("Time: ");
    display.print(timeMs, 1);
    display.print(" ms");

    display.setCursor(10, 75);
    display.print("Best: ");
    display.print(bestMs, 1);
    display.print(" ms");
  } while (display.nextPage());
}
